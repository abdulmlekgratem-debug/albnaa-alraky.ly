# ==============================================================================
# مصدر بيانات أسعار مواد البناء (Google Sheets / Excel Online)
# ==============================================================================

# الخيار A: معرّف Google Sheet (Google Sheet ID)
# مثال: إذا كان الرابط https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
# ضع المعرّف فقط: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
VITE_GOOGLE_SHEET_ID=

# الخيار B: رابط XLSX مباشر أو رابط مشاركة كامل
# مثال: https://docs.google.com/spreadsheets/d/.../export?format=xlsx
# أو: https://1drv.ms/u/...
VITE_EXCEL_PUBLIC_URL=

# مدة صلاحية الكاش بالثواني (الافتراضي 60 ثانية)
VITE_CACHE_SECONDS=60

# وضع عرض الأسعار: live للنشر أو calibration لإخفاء الأرقام مؤقتًا أثناء المراجعة
VITE_PRICE_DISPLAY_MODE=calibration
